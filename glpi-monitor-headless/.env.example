# ===== GLPI =====
GLPI_URL=https://seu-glpi.exemplo.com/glpi
# Credenciais: prefira data/credentials.json {"glpiUser":"...","glpiPass":"..."}
# (ou descomente abaixo)
#GLPI_USER=
#GLPI_PASS=

# ===== Monitoramento =====
TEMPO_ATUALIZACAO_MS=45000
INTERVALO_RECARGA_BROWSER_MS=1800000
DEBUG=false
# Avisa no Telegram após N verificações seguidas com falha
FALHAS_PARA_ALERTA=5
# Notificação/som no desktop (precisa de node-notifier; desligue em servidor)
NOTIFICACAO_DESKTOP=true
# Mensagem "monitor iniciado" no Telegram a cada start
NOTIFICAR_INICIO=true
# Bloqueia imagens/fontes nas verificações (economiza banda; teste antes de ligar)
BLOQUEAR_RECURSOS=false

# ===== Telegram =====
TELEGRAM_TOKEN=8628561172:AAEE0Bb6kULwKVPYwLRQ7YlA8S9XPllT_Y4
TELEGRAM_CHAT_ID=-5424094631

# ===== Técnicos =====
# Separados por vírgula, TUDO NA MESMA LINHA (quebra de linha faz o dotenv
# descartar o resto). Para listas grandes, use data/tecnicos.txt (um por linha).
TECNICOS=Nome Um,Nome Dois
